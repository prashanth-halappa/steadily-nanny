+        // PATCHED (steadily-nanny): props graphs can contain objects with
+        // throwing getters (e.g. expo-router's NavigationStateContext default
+        // value, whose accessors all throw). This is a dev-only diagnostic
+        // dump — a getter that throws must degrade to a placeholder, not
+        // crash the render. Object.keys (unlike Object.entries) does not
+        // invoke getters, so each property is read individually under guard.
+        for (const key of Object.keys(value)) {
+            let propValue;
+            try {
+                propValue = value[key];
+            }
+            catch {
+                newValue[key] = "[Unserializable]";
+                continue;
+            }
+            try {
+                newValue[key] = replace(key, propValue);
+            }
+            catch {
+                newValue[key] = "[Unserializable]";
+            }
         }
         seen.delete(value);
         return newValue;
