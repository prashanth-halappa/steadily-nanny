# Supabase temp files
supabase/.temp/

# Maestro `takeScreenshot` writes <name>.png into the cwd it was run from.
# apps/mobile has no legitimate root-level images (they live in assets/).
apps/mobile/*.png
# Maestro flow screenshots — local E2E artifacts, regenerated every run.
apps/mobile/.maestro/**/*.png

# Design staging area — icon concepts, not shipped assets (audit F-B11-10)
apps/mobile/assets/_staging/
supabase/.branches/
.claude/worktrees/

# Wrangler local dev state (miniflare caches, D1 sqlite) — never committed.
infra/nanny-site/.wrangler/
