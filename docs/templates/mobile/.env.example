# Mobile environment variables.
#
# RULES:
# - Only EXPO_PUBLIC_* vars are inlined into the client bundle by Expo.
# - Reference them STATICALLY as process.env.EXPO_PUBLIC_X (no dynamic keys) or
#   Expo's compile-time inlining won't replace them.
# - Anything here ships in the app binary — treat all of these as PUBLIC.
#   Never put server secrets / service-role keys in an EXPO_PUBLIC_* var.
# - Copy this file to `.env` and fill in real values locally.

# --- Backend API ---
EXPO_PUBLIC_API_URL=<your-api-base-url>            # e.g. http://localhost:3000 (Android emulator auto-rewrites localhost -> 10.0.2.2)

# --- Supabase (Auth + DB + Storage) ---
EXPO_PUBLIC_SUPABASE_URL=<your-supabase-url>
EXPO_PUBLIC_SUPABASE_ANON_KEY=<your-supabase-anon-key>

# --- Auth providers (native Google / Apple sign-in) ---
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=<your-google-ios-client-id>
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=<your-google-web-client-id>

# --- Analytics (PostHog) ---
EXPO_PUBLIC_POSTHOG_API_KEY=<your-posthog-project-key>

# --- Error tracking (Sentry) ---
EXPO_PUBLIC_SENTRY_DSN=<your-sentry-dsn>

# --- Subscriptions (RevenueCat) — omit if you have no paywall ---
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=<your-revenuecat-ios-key>
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=<your-revenuecat-android-key>
EXPO_PUBLIC_REVENUECAT_TEST_API_KEY=<your-revenuecat-test-key>
