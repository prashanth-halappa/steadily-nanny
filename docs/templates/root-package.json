{
  "name": "steadilynanny",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:mobile": "turbo run dev --filter=@steadily-nanny/mobile",
    "dev:api": "turbo run dev --filter=@steadily-nanny/api",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "biome check --write --unsafe . && biome format --write .",
    "format:check": "biome format .",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules",
    "qc": "./scripts/qc.sh",
    "setup": "bun scripts/setup.ts",
    "g": "sh -c 'git add . && git status && git commit -m \"$1\" && git push' _",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.0",
    "husky": "9.1.7",
    "lint-staged": "16.2.7",
    "turbo": "2.9.18",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "overrides": {
    "zod": "4.4.3"
  },
  "packageManager": "bun@1.3.9",
  "lint-staged": {
    "*.{ts,tsx}": [
      "biome check --write --no-errors-on-unmatched",
      "biome format --write --no-errors-on-unmatched"
    ],
    "*.json": [
      "biome format --write --no-errors-on-unmatched"
    ]
  }
}
