{
  "name": "@steadily-nanny/api",
  "version": "1.0.0",
  "description": "Express 5 on Cloudflare Workers + D1 + Better Auth API",
  "private": true,
  "main": "src/index.ts",
  "scripts": {
    "start": "wrangler dev",
    "dev": "mkdir -p logs && LOG_LEVEL=debug wrangler dev --test-scheduled 2>&1 | tee -a logs/dev.log",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write --unsafe . && biome format --write .",
    "format:check": "biome format .",
    "test": "bash scripts/run-tests-one-file.sh tests/unit",
    "test:db": "bash scripts/run-tests-one-file.sh tests/integration",
    "test:coverage": "bun test --coverage",
    "db:migrate": "bash scripts/db-migrate.sh",
    "qa:smoke": "bun scripts/qa-smoke.ts",
    "clean": "rm -rf dist node_modules",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@better-auth/expo": "1.7.27",
    "@sentry/cloudflare": "11.16.0",
    "@steadily-nanny/shared-types": "*",
    "@supabase/supabase-js": "^2.80.0",
    "better-auth": "1.7.27",
    "compression": "1.8.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "0.45.4",
    "expo-server-sdk": "^6.1.0",
    "express": "^5.2.1",
    "express-rate-limit": "8.5.2",
    "helmet": "^8.1.0",
    "i18next": "26.3.1",
    "node-cache": "5.1.2",
    "resend": "6.14.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@better-auth/cli": "1.4.21",
    "@cloudflare/workers-types": "5.20261121.1",
    "@types/compression": "1.8.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.0",
    "bun-types": "1.3.14",
    "drizzle-kit": "0.31.11",
    "typescript": "7.0.2",
    "wrangler": "4.166.0"
  }
}
