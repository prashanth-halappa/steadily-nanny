# ============================================================================
# API environment — copy to `.env` and fill in. Never commit real secrets.
# ============================================================================
# Validated at boot by src/config/env.ts (fail-fast). Required vars have no
# default and crash the process if missing. Vars marked "prod-required" are
# optional in dev/test but enforced in production.

# ── Server ──────────────────────────────────────────────────────────────────
PORT=8080
NODE_ENV=development

# ── Better Auth (secret required) ────────────────────────────────────────────
# On Workers these come from `wrangler secret put` / wrangler.jsonc vars; for
# `wrangler dev` put them in .dev.vars. Generate: `openssl rand -base64 32`.
BETTER_AUTH_SECRET=change-me-to-at-least-32-random-characters
# Public origin of this API (auth routes live under /api/auth). Default
# http://localhost:8787 (wrangler dev).
BETTER_AUTH_URL=http://localhost:8787

# ── Social sign-in (optional; a provider is on only when its client id is set) ─
# Apple: Services ID (web/Android OAuth) + iOS bundle id (native id token).
APPLE_CLIENT_ID=
APPLE_APP_BUNDLE_IDENTIFIER=
# Only the Android/web redirect flow needs it: a JWT signed with the .p8 key
# (team id, key id; max 6 months, so it must be regenerated). Native iOS
# id-token sign-in works without it.
APPLE_CLIENT_SECRET=
# Google: web client id (also Android's serverClientId) + iOS client id. Both
# are accepted as the id-token audience. The secret is only needed for a web
# redirect flow, which the app does not use.
GOOGLE_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Monitoring (optional) ────────────────────────────────────────────────────
SENTRY_DSN=
# info hides per-request access lines (they log at the quieter `http` level);
# `bun run dev` overrides to debug so logs/dev.log keeps full request cycles.
LOG_LEVEL=info

# ── Background jobs (prod-required) ──────────────────────────────────────────
# Shared secret for the X-Job-Api-Key header on /api/jobs/* (used by pg_cron).
JOB_API_KEY=change-me

# jobHealthJob (J1-b, daily 06:15) alert recipients. Optional — read directly
# via process.env, not validated at boot. If unset, an unhealthy job-health
# run still records its findings in job_runs.summary, it just logs a warning
# instead of alerting anyone.
# Comma-separated user ids that each get one push (OPS_JOB_HEALTH) when a
# registered cron job is stale/missing/failed.
OPS_ALERT_USER_IDS=

# ── Email/password auth (dev/test only — never set in production) ────────────
# On only when exactly 'true'. Production signs in with Apple/Google only.
EMAIL_AUTH_ENABLED=true

# ── Analytics ────────────────────────────────────────────────────────────────
# Mobile-only. Nothing in apps/api/src reads this and it isn't in the Zod
# schema; it lives in apps/api/.env only so both keys sit in one place. Do NOT
# set it as a Worker secret.
# POSTHOG_API_KEY=

# ── App-specific (example — see src/config/app.env.ts) ───────────────────────
APP_EXAMPLE_FEATURE_ENABLED=false

# ----------------------------------------------------------------------------
# Minimal boot in dev: only BETTER_AUTH_SECRET is required. Unit tests need
# NONE of these — env.ts short-circuits to placeholders when NODE_ENV=test.
