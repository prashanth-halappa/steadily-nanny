# ============================================================================
# API environment — copy to `.env` and fill in. Never commit real secrets.
# ============================================================================
# Validated at boot by src/config/env.ts (fail-fast). Required vars have no
# default and crash the process if missing. Vars marked "prod-required" are
# optional in dev/test but enforced in production.

# ── Server ──────────────────────────────────────────────────────────────────
PORT=8080
NODE_ENV=development

# ── Supabase (required) ──────────────────────────────────────────────────────
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key   # server-only; never expose to clients
# Direct Postgres connection string (Dashboard -> Connect -> Direct). Only
# read by scripts/e2e-assert.ts's RLS-parity checks (pg_catalog is not
# reachable through PostgREST); the API itself never uses it. Optional -
# missing means those checks SKIP.
SUPABASE_DB_URL=postgresql://postgres:YOUR-PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# ── LLM via Vertex AI (optional at boot; required only once a call is made) ──
# Auth is Application Default Credentials (ADC) — NOT an API key.
# Locally: `gcloud auth application-default login`, or set
# GOOGLE_APPLICATION_CREDENTIALS to a service-account JSON path.
# No domain currently calls into src/config/llmProvider.ts, so this can stay
# blank — llmProvider throws a clear error naming this var if it's unset when
# a model factory is actually invoked.
GOOGLE_VERTEX_PROJECT=your-gcp-project-id
GOOGLE_VERTEX_LOCATION=us-central1
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ── Monitoring (optional) ────────────────────────────────────────────────────
SENTRY_DSN=
# info hides per-request access lines (they log at the quieter `http` level);
# `bun run dev` overrides to debug so logs/dev.log keeps full request cycles.
LOG_LEVEL=info

# ── Background jobs (prod-required) ──────────────────────────────────────────
# Shared secret for the X-Job-Api-Key header on /api/jobs/* (used by pg_cron).
JOB_API_KEY=change-me

# ── Email via Resend (prod-required) ─────────────────────────────────────────
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM=steadilynanny <hello@nanny.getsteadily.app>

# ── App-specific (example — see src/config/app.env.ts) ───────────────────────
APP_EXAMPLE_FEATURE_ENABLED=false

# ----------------------------------------------------------------------------
# Minimal boot in dev without real Supabase: the 3 required vars
# (SUPABASE_URL/ANON/SERVICE) must be present or the process exits at startup.
# GOOGLE_VERTEX_PROJECT is optional at boot — see the LLM section above.
# Unit tests need NONE of these — env.ts short-circuits to placeholders when
# NODE_ENV=test.
