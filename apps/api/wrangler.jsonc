// Cloudflare Workers config for the API (Express via nodejs_compat + cloudflare:node).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "steadily-nanny-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-01",
  // nodejs_compat also populates process.env from vars/secrets (default for
  // compat dates >= 2025-04-01), which is what src/config/env.ts validates.
  "compatibility_flags": ["nodejs_compat"],
  // Local dev always on :8080 (mobile .env, Maestro and BETTER_AUTH_URL expect it).
  "dev": { "port": 8080 },
  "observability": { "enabled": true },
  "routes": [{ "pattern": "api.nanny.getsteadily.app", "custom_domain": true }],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "steadily-nanny",
      // Created 2026-11-22, region ENAM (eastern North America).
      "database_id": "e005f65c-5eed-48de-a8bd-799d63d826c3",
      "migrations_dir": "migrations"
    }
  ],

  // Non-secret config. NODE_ENV=production switches on the production-required
  // checks in env.ts (JOB_API_KEY, RESEND_API_KEY must be set as secrets).
  "vars": {
    "NODE_ENV": "production",
    "LOG_LEVEL": "info",
    "EMAIL_FROM": "steadilynanny <hello@nanny.getsteadily.app>",
    "BETTER_AUTH_URL": "https://api.nanny.getsteadily.app"
  },

  // Secrets (set with `wrangler secret put <NAME>`; use .dev.vars locally):
  //   BETTER_AUTH_SECRET     (required, >= 32 chars; rotating it signs everyone out)
  //   APPLE_CLIENT_ID, APPLE_APP_BUNDLE_IDENTIFIER   (Apple on when CLIENT_ID set)
  //   APPLE_CLIENT_SECRET    (optional: only the Android/web redirect flow needs it;
  //                           a .p8-signed JWT that expires within 6 months)
  //   GOOGLE_CLIENT_ID, GOOGLE_IOS_CLIENT_ID          (Google on when CLIENT_ID set)
  //   GOOGLE_CLIENT_SECRET   (optional: id-token sign-in does not use it)
  //   RESEND_API_KEY, RESEND_WEBHOOK_SECRET
  //   JOB_API_KEY            (only for manual POST /api/jobs/*; cron needs no key)
  //   SENTRY_DSN
  //   OPS_ALERT_EMAILS, OPS_ALERT_USER_IDS   (optional, job-health alerting)
  //   POSTHOG_API_KEY                         (optional)

  // ONE every-minute trigger (free plan allows 5). Each job's own schedule
  // lives in CRON_JOBS in src/scheduled.ts and is matched on every tick.
  "triggers": {
    "crons": ["* * * * *"]
  }
}
