# Copy to .env and fill in. All client-visible vars MUST be prefixed EXPO_PUBLIC_
# (Expo inlines only static process.env.EXPO_PUBLIC_* literals at build time).

# API base URL (include the /api suffix if your API mounts routes under /api)
EXPO_PUBLIC_API_URL=http://localhost:3000/api

# Supabase (Project Settings → API)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-SUPABASE-ANON-KEY

# Sentry DSN (optional — errors are silently dropped if unset)
EXPO_PUBLIC_SENTRY_DSN=

# PostHog (optional — analytics disabled if the key is unset)
EXPO_PUBLIC_POSTHOG_API_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Google Sign-In OAuth client ids (from Google Cloud console)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
