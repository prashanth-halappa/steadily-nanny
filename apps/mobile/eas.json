{
  "cli": {
    "version": ">= 16.6.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "bun": "1.3.9",
      "env": {
        "EXPO_USE_PRECOMPILED_MODULES": "0"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "bun": "1.3.9",
      "env": {
        "SENTRY_DISABLE_AUTO_UPLOAD": "true",
        "EXPO_USE_PRECOMPILED_MODULES": "0"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "bun": "1.3.9",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.nanny.getsteadily.app/api",
        "SENTRY_ALLOW_FAILURE": "false",
        "EXPO_USE_PRECOMPILED_MODULES": "0"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./SETUP-play-service-account.json",
        "releaseStatus": "draft"
      }
    }
  }
}
