{
  "name": "@steadily-nanny/mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "mkdir -p logs && bun expo start -c 2>&1 | tee -a logs/dev.log",
    "start": "bun expo start",
    "android": "bun expo start --android",
    "ios": "bun expo start --ios",
    "test": "bash scripts/run-tests-one-file.sh src && bash scripts/run-tests-one-file.sh lib",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "test:all": "bun test --timeout 60000",
    "test:e2e": "bash scripts/run-maestro.sh --exclude-tags=manual .maestro/tests",
    "test:e2e:critical": "bash scripts/run-maestro.sh --include-tags=critical --exclude-tags=manual .maestro/tests",
    "test:e2e:scheduling": "bash scripts/run-maestro.sh --include-tags=scheduling --exclude-tags=manual .maestro/tests",
    "test:e2e:timesheet": "bash scripts/run-maestro.sh --include-tags=timesheet --exclude-tags=manual .maestro/tests",
    "lint": "biome check --diagnostic-level=warn .",
    "cleanrun": "bun pm cache rm && bun expo start -c",
    "format": "biome check --write --unsafe . && biome format --write .",
    "format:check": "biome format .",
    "build": "expo export --platform all",
    "typecheck": "tsc --noEmit",
    "build:dev:ios": "EXPO_USE_PRECOMPILED_MODULES=0 eas build --platform ios --profile development",
    "build:dev:android": "EXPO_USE_PRECOMPILED_MODULES=0 eas build --platform android --profile development",
    "build:prod:ios": "EXPO_USE_PRECOMPILED_MODULES=0 eas build --platform ios --profile production --auto-submit",
    "build:prod:android": "EXPO_USE_PRECOMPILED_MODULES=0 eas build --platform android --profile production"
  },
  "trustedDependencies": [
    "@sentry/cli"
  ],
  "dependencies": {
    "@expo/ui": "~57.0.9",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-google-signin/google-signin": "^16.0.0",
    "@rn-primitives/accordion": "^1.2.0",
    "@rn-primitives/alert-dialog": "^1.2.0",
    "@rn-primitives/aspect-ratio": "^1.2.0",
    "@rn-primitives/avatar": "^1.2.0",
    "@rn-primitives/checkbox": "^1.2.0",
    "@rn-primitives/collapsible": "^1.2.0",
    "@rn-primitives/context-menu": "^1.2.0",
    "@rn-primitives/dialog": "^1.2.0",
    "@rn-primitives/dropdown-menu": "^1.2.0",
    "@rn-primitives/hover-card": "^1.2.0",
    "@rn-primitives/label": "^1.2.0",
    "@rn-primitives/menubar": "^1.2.0",
    "@rn-primitives/navigation-menu": "^1.2.0",
    "@rn-primitives/popover": "^1.2.0",
    "@rn-primitives/portal": "^1.3.0",
    "@rn-primitives/progress": "^1.2.0",
    "@rn-primitives/radio-group": "^1.2.0",
    "@rn-primitives/select": "^1.2.0",
    "@rn-primitives/separator": "^1.2.0",
    "@rn-primitives/slot": "^1.2.0",
    "@rn-primitives/switch": "^1.2.0",
    "@rn-primitives/table": "^1.2.0",
    "@rn-primitives/tabs": "^1.2.0",
    "@rn-primitives/toggle": "^1.2.0",
    "@rn-primitives/toggle-group": "^1.2.0",
    "@rn-primitives/tooltip": "^1.2.0",
    "@sentry/react-native": "~7.11.0",
    "@shopify/flash-list": "2.0.2",
    "@stardazed/streams-text-encoding": "1.0.2",
    "@steadily-nanny/shared-types": "*",
    "@supabase/supabase-js": "2.108.2",
    "@tanstack/react-query": "5.101.0",
    "@ungap/structured-clone": "1.3.1",
    "axios": "^1.18.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "expo": "^57.0.0",
    "expo-apple-authentication": "~57.0.0",
    "expo-application": "~57.0.0",
    "expo-build-properties": "~57.0.2",
