# Maestro E2E credentials + fixture IDs (copy to .env.maestro — gitignored).
# Seed accounts: bun run scripts/seed-test-users.ts (repo root).
# Password matches scripts/seed-test-users.ts TEST_PASSWORD.

PARENT_EMAIL=parent@steadilynanny.test
PARENT_PASSWORD=SteadilyTest!2026

NANNY_EMAIL=nanny@steadilynanny.test
NANNY_PASSWORD=SteadilyTest!2026

# Product-flow fixtures — create through the app (or SQL) before running
# tagged scheduling / timesheet scenarios. Leave blank until seeded.
EXTRA_SHIFT_ID=
DEMOTED_SHIFT_ID=
TIME_ENTRY_ID=

# Absolute Monday ISO for Hours deep-link regression (flow 05).
# Must be within Hours history window (≤ MAX_WEEKS_BACK = 104 weeks / 2 years
# — see apps/mobile/src/domains/timesheet/components/HoursScreen.tsx) and
# MUST be an actual Monday — weeksBetween() rounds, so a non-Monday resolves
# to the previous Monday and the hours-active-week-<ISO> marker never matches.
# Also SEED_TIMESHEET_WEEK_START in scripts/seed-e2e-approval-fixtures.ts —
# the only week seeded with a `submitted` timesheet (flow 04's actionable week).
HOURS_DEEPLINK_WEEK_START=2026-01-05

# --- Phase 4 (§9) cross-cutting flows 07-15 ------------------------------
# Everything below is produced by scripts/seed-phase4-fixtures.ts and injected
# by apps/mobile/.maestro/run-phase4.sh, which eval's the seeder's KEY=VALUE
# output and spells out one `-e KEY=VAL` argument per pair. You do NOT need to
# fill these in by hand — they are listed here so the contract is written down
# rather than only living in the driver.
#
# The ONE value the driver cannot derive:
#
# Job-endpoint secret. Must match JOB_API_KEY in apps/api/.env — the driver
# curls POST /api/jobs/cover-ask-expiry between flows 13a and 13b to expire the
# seeded cover ask (auth is the `x-job-api-key` header, apps/api/src/
# middlewares/jobAuth.ts; the router sits BEFORE the Supabase auth layer, so no
# bearer token is involved).
JOB_API_KEY=change-me
#
# Optional. Password for the per-run seeded accounts flow 14 signs in as.
# Defaults to PARENT_PASSWORD, which is correct while
# scripts/seed-phase4-fixtures.ts and scripts/seed-test-users.ts share one
# TEST_PASSWORD. Set it only if you change one and not the other.
# PHASE4_TEST_PASSWORD=SteadilyTest!2026
#
# Seeder-supplied, per run (documented, not configured):
#   PHASE4_HOUSEHOLD_ID            "Our household" — the one the nanny is in
#   PHASE4_NANNY_ID                carerId in /settings/pay/setup/<carerId>
#   PHASE4_PARENT_ID
#   PHASE4_SEED_WEEK_START         2026-01-05 — flows 11/12 (reset to
#                                  `submitted` on every seed so the batch
#                                  re-runs; flow 11 approves it, 12 pays it)
#   PHASE4_OT_WEEK_START           2026-01-12 — one 13h day: 8 regular +
#                                  4 overtime + 1 double time (flow 07)
#   PHASE4_HOLIDAY_WEEK_START      2026-01-19 — Martin Luther King, Jr. Day
#                                  2026 AND that week's Monday (flow 09)
#   PHASE4_SUNDAY_HOUSEHOLD_ID     second household, week_starts_on = 0
#   PHASE4_SUNDAY_WEEK_START       2026-01-04, a Sunday (flow 10)
#   PHASE4_ARRANGEMENT_VALID_FROM  2026-01-01 — backdated to cover every week
#                                  above; only the FUTURE horizon is refused
#   PHASE4_HOURLY_RATE             typed into pay-setup-rate-input
#   PHASE4_HOLIDAY_MULTIPLIER      worked-holiday multiplier (flow 09 needs it)
#   PHASE4_TODAY_SHIFT_ID          confirmed shift TODAY that the sick day
#                                  overlaps (flow 08) — comes from
#                                  scripts/seed-e2e-approval-fixtures.ts, so
#                                  that seeder must have run TODAY
#   PHASE4_EXPIRED_ASK_SHIFT_ID    cover ask tomorrow, deadline already past
#   PHASE4_DECLINE_ASK_SHIFT_ID    cover ask tomorrow, deadline 12h out
#   PHASE4_NEW_PARENT_EMAIL        fresh confirmed account, new every run
#   PHASE4_DRAFT_CODE_A            draft-household invite code (flow 14)
#   PHASE4_DRAFT_CODE_B            draft-household invite code (flow 15)
